# ASR
OPENROUTER_API_KEY=sk-or-v1-...

# LLM (recommended: Vertex AI Agent Platform)
GEMINI_AGENT_PLATFORM_API_KEY=
# AGENT_PLATFORM_API_KEY=        # optional compatibility alias
# GEMINI_API_KEY=                # optional Google AI Studio fallback

# Untested alternatives (Gemini stays the recommended model). Each model tries
# its native key, then the relay, then OPENROUTER_API_KEY above.
# ANTHROPIC_API_KEY=            # claude-sonnet-5-5 / claude-opus-5-5 / claude-fable-5-1
# OPENAI_API_KEY=               # gpt-6.1-sol
# LLM_RELAY_BASE_URL=https://relay.example/v1   # OpenAI-compatible relay
# LLM_RELAY_API_KEY=

# Optional OCR context classification via Jev (only relevant with --ocr-json).
# Official TypeSafe API (preferred):
# TYPESAFE_API_KEY=
# Or Cloudflare Workers AI:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# JEV_BACKEND=typesafe|cloudflare   # force a backend when both are configured
# If none are set, raw OCR text goes straight to the pre-pass unfiltered.

# Optional model overrides (default: gemini-3.8-flash for every stage)
# Allowed LLM models: gemini-3.8-flash / gemini-4-argon / gemini-3.1-pro-preview,
# plus the untested claude-sonnet-5-5 / claude-opus-5-5 / claude-fable-5-1 / gpt-6.1-sol.
# gemini-4-argon is served only on the global location; point the Vertex
# endpoint at your project so both models resolve there:
# GEMINI_AGENT_PLATFORM_BASE_URL=https://aiplatform.googleapis.com/v1beta1/projects/<project-id-or-number>/locations/global/publishers/google/models
# Unsupported overrides fail before ASR/download; no silent fallback.
# GEMINI_MODEL=gemini-3.8-flash   # all stages at once
# SEGMENT_MODEL=gemini-3.8-flash
# TRANSLATE_MODEL=gemini-3.8-flash
# PREPASS_MODEL=gemini-3.8-flash
# LLM_THINKING_LEVEL=MEDIUM       # 3.x models only (LOW/MEDIUM/HIGH)
# LLM_MAX_OUTPUT_TOKENS=65536
# LLM_TIMEOUT=1800                # seconds per LLM request
# Lines per LLM call; bounded by the model's OUTPUT cap, not its context.
# SEGMENT_BATCH_SIZE=1000
# TRANSLATE_BATCH_SIZE=1000

# Optional external glossary kept outside this repository; the GUI merges it
# below the shared glossaries/<name>.md and each job's glossary_user.md
# TRANSLATE_GLOSSARY_PATH=/absolute/path/to/private-glossary.md
# Optional base glossary retained when GUI/job corrections use the glossary above
# TRANSLATE_BASE_GLOSSARY_PATH=/absolute/path/to/full-legacy-glossary.md

# Subtitle queue (Homeserver worker only)
# MAIJEV_BILIUP_PYTHON=/path/to/venv/bin/python3   # interpreter with biliup installed
# MAIJEV_PHONE_VIDEO_DIRS=/extra/dir1:/extra/dir2   # extra allowed phone-video dirs
