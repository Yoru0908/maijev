# ASR
OPENROUTER_API_KEY=sk-or-v1-...

# LLM (recommended: Vertex AI Agent Platform)
GEMINI_AGENT_PLATFORM_API_KEY=
# AGENT_PLATFORM_API_KEY=        # optional compatibility alias
# GEMINI_API_KEY=                # optional Google AI Studio fallback

# Optional OCR context classification via Cloudflare Workers AI Jev.
# Only relevant with --ocr-json; if unset, raw OCR text goes straight
# to the pre-pass without JEV filtering.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional model overrides
# SEGMENT_MODEL=gemini-2.5-pro
# TRANSLATE_MODEL=gemini-2.5-pro
# PREPASS_MODEL=gemini-2.5-pro
# LLM_MAX_OUTPUT_TOKENS=65000

# Optional external glossary kept outside this repository
# TRANSLATE_GLOSSARY_PATH=/absolute/path/to/private-glossary.md
