# ASR
OPENROUTER_API_KEY=sk-or-v1-...

# LLM (recommended: Vertex AI Agent Platform)
GEMINI_AGENT_PLATFORM_API_KEY=
# AGENT_PLATFORM_API_KEY=        # optional compatibility alias
# GEMINI_API_KEY=                # optional Google AI Studio fallback

# Optional OCR context classification via Jev (only relevant with --ocr-json).
# Official TypeSafe API (preferred):
# TYPESAFE_API_KEY=
# Or Cloudflare Workers AI:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# JEV_BACKEND=typesafe|cloudflare   # force a backend when both are configured
# If none are set, raw OCR text goes straight to the pre-pass unfiltered.

# Optional model overrides (default: gemini-3.8-flash for every stage)
# GEMINI_MODEL=gemini-3.8-flash   # all stages at once
# SEGMENT_MODEL=gemini-3.8-flash
# TRANSLATE_MODEL=gemini-3.8-flash
# PREPASS_MODEL=gemini-3.8-flash
# LLM_THINKING_LEVEL=MEDIUM       # 3.x models only (LOW/MEDIUM/HIGH)
# LLM_MAX_OUTPUT_TOKENS=65536
# Lines per LLM call; bounded by the model's OUTPUT cap, not its context.
# SEGMENT_BATCH_SIZE=1000
# TRANSLATE_BATCH_SIZE=1000

# Optional external glossary kept outside this repository
# TRANSLATE_GLOSSARY_PATH=/absolute/path/to/private-glossary.md
# Optional base glossary retained even when GUI/job corrections override the file above
# TRANSLATE_BASE_GLOSSARY_PATH=/absolute/path/to/full-legacy-glossary.md
# TRANSLATE_PROFILE=generic
# CLI --translation-profile yamakawa-ui selects Ui's tone for one task.
